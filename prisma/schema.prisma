generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  password      String?
  phone         String?
  role          UserRole        @default(DONOR)
  createdAt     DateTime        @default(now())
  address       String?
  authId        String?         @unique
  avatar        String?
  city          String?
  isActive      Boolean         @default(true)
  isVerified    Boolean         @default(false)
  state         String?
  updatedAt     DateTime        @updatedAt
  zipCode       String?
  beneficiary   Beneficiary?
  complaints    Complaint[]
  donations     Donation[]
  ngo           Ngo?
  notifications Notification[]
  statusChanges StatusHistory[] @relation("ChangedByUser")
}

model Ngo {
  id                 String                @id @default(uuid())
  userId             String                @unique
  ngoName            String
  registrationNumber String                @unique
  description        String?
  website            String?
  logo               String?
  address            String
  city               String
  state              String
  zipCode            String?
  verificationStatus NgoVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  categories         ItemCategory[]        @default([])
  capacity           Int                   @default(100)
  currentLoad        Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  beneficiaries      Beneficiary[]
  acceptedDonations  Donation[]
  inventory          Inventory[]
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Beneficiary {
  id            String               @id @default(uuid())
  userId        String               @unique
  ngoId         String?
  householdSize Int?
  needCategory  ItemCategory[]       @default([])
  description   String?
  isVerified    Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  ngo           Ngo?                 @relation(fields: [ngoId], references: [id])
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests      BeneficiaryRequest[]
}

model Donation {
  id            String          @id @default(uuid())
  donorId       String
  status        DonationStatus  @default(PENDING)
  createdAt     DateTime        @default(now())
  ngoId         String?
  notes         String?
  totalItems    Int             @default(0)
  updatedAt     DateTime        @updatedAt
  donor         User            @relation(fields: [donorId], references: [id], onDelete: Cascade)
  ngo           Ngo?            @relation(fields: [ngoId], references: [id])
  items         DonationItem[]
  pickupRequest PickupRequest?
  statusHistory StatusHistory[]
}

model DonationItem {
  id          String        @id @default(uuid())
  donationId  String
  itemName    String
  quantity    Int           @default(1)
  imageUrl    String?
  condition   ItemCondition @default(GOOD)
  createdAt   DateTime      @default(now())
  description String?
  category    ItemCategory
  donation    Donation      @relation(fields: [donationId], references: [id], onDelete: Cascade)
}

model PickupRequest {
  id            String       @id @default(uuid())
  donationId    String       @unique
  address       String
  city          String
  state         String
  zipCode       String?
  landmark      String?
  scheduledDate DateTime
  scheduledTime String?
  contactPhone  String
  status        PickupStatus @default(SCHEDULED)
  notes         String?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  donation      Donation     @relation(fields: [donationId], references: [id], onDelete: Cascade)
}

model StatusHistory {
  id          String          @id @default(uuid())
  donationId  String
  fromStatus  DonationStatus?
  toStatus    DonationStatus
  notes       String?
  changedById String?
  changedAt   DateTime        @default(now())
  changedBy   User?           @relation("ChangedByUser", fields: [changedById], references: [id])
  donation    Donation        @relation(fields: [donationId], references: [id], onDelete: Cascade)
}

model BeneficiaryRequest {
  id            String        @id @default(uuid())
  beneficiaryId String
  category      ItemCategory
  quantity      Int           @default(1)
  description   String?
  status        RequestStatus @default(OPEN)
  fulfilledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  beneficiary   Beneficiary   @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

model Inventory {
  id           String        @id @default(uuid())
  ngoId        String
  itemName     String
  category     ItemCategory
  quantity     Int           @default(0)
  condition    ItemCondition @default(GOOD)
  receivedDate DateTime      @default(now())
  expiryDate   DateTime?
  status       String        @default("available")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ngo          Ngo           @relation(fields: [ngoId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Complaint {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("open")
  response  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
}

enum UserRole {
  DONOR
  NGO
  BENEFICIARY
  ADMIN
}

enum DonationStatus {
  PENDING
  ACCEPTED
  PICKUP_SCHEDULED
  COLLECTED
  DISTRIBUTED
  COMPLETED
  RECEIVED
  CANCELLED
}

enum ItemCategory {
  CLOTHES
  BOOKS
  TOYS
  FURNITURE
  KITCHEN
  ELECTRONICS
  STATIONERY
  HOUSEHOLD
  OTHER
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  WORN
}

enum NgoVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PickupStatus {
  SCHEDULED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  FULFILLED
  CLOSED
}

enum NotificationType {
  DONATION_CREATED
  DONATION_ACCEPTED
  DONATION_STATUS_UPDATE
  PICKUP_SCHEDULED
  PICKUP_COMPLETED
  NGO_VERIFIED
  REQUEST_UPDATE
  SYSTEM
}
